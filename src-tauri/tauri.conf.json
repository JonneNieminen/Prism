{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism",
  "version": "1.0.0",
  "identifier": "com.jonnenieminen.prism",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run fetch-ytdlp && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prism",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 660,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0B0B12",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/projects/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "copyright": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../models/htdemucs/": "models/htdemucs/", "bin/": "bin/" },
    "macOS": { "minimumSystemVersion": "13.0" },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEREI2NDBEOTFFQTZFODUKUldTRmJ1cVJEV1RiZmNMNk9vTVF2Ly9QVW50SGthZS9zYjhnL0JNaDJud2pPNk5aR245M2tTNGYK",
      "endpoints": ["https://github.com/JonneNieminen/Prism/releases/latest/download/latest.json"]
    }
  }
}
